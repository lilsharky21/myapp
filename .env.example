# Copy this file to ".env" (for running on your computer) and fill in your keys.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.
# Never put real keys in this file or anywhere else in the code.

# Prices, company info, key stats, analyst ratings, earnings, insiders, news
# Free key: https://finnhub.io/register
FINNHUB_API_KEY=

# Price history for charts and technicals
# Free key: https://twelvedata.com/register
TWELVEDATA_API_KEY=

# The SEC asks every app to say who it is. Use your app name and your email.
SEC_USER_AGENT=Thesis Journal your-email@example.com

# Research notes synced from your Mac to your phone. Vercel adds this for you
# when you create a Blob store (Storage -> Create -> Blob) and connect it.
BLOB_READ_WRITE_TOKEN=

# Optional (18+ only): Google's Gemini free tier, so the phone can write notes itself.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use
GEMINI_MODEL=gemini-2.5-flash

# Optional: a passcode so only you can use the app's data and AI.
# The app asks for it once on each device.
APP_PASSCODE=
